{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "DataDirectory": "data",
    "FlushAuditToDisk": true,
    "AuditSegmentMaxBytes": 67108864,
    "AuditRetentionDays": null,
    "MinimumFreeDiskBytes": 1073741824
  },
  "AuditQuery": {
    "DefaultDays": 30
  },
  "Auth": {
    "RequireHttps": true,
    "ApiKeys": []
  },
  "RateLimiting": {
    "Enabled": true,
    "DoorControllerPermitsPerMinute": 120,
    "UserPermitsPerMinute": 600,
    "AnonymousPermitsPerMinute": 60
  }
}
